{
  "name": "Video Automation",
  "version": 1,
  "color": {
    "themes": [
      { "id": "light", "name": "Light" },
      { "id": "dark", "name": "Dark" }
    ],
    "tokens": [
      { "name": "surface", "value": { "light": "#ffffff", "dark": "#121214" }, "usage": "Page background." },
      { "name": "surface-raised", "value": { "light": "#f6f6f8", "dark": "#1b1b1f" }, "usage": "Cards, panels, menus." },
      { "name": "surface-sunken", "value": { "light": "#edeef1", "dark": "#0b0b0d" }, "usage": "Inputs, wells, progress tracks." },
      { "name": "line", "value": { "light": "#e3e4e8", "dark": "#2a2b30" }, "usage": "Default borders and dividers." },
      { "name": "line-strong", "value": { "light": "#c7c9d1", "dark": "#3d3e45" }, "usage": "Input borders and control outlines." },
      { "name": "ink", "value": { "light": "#17181c", "dark": "#f3f3f5" }, "usage": "Primary text and icons on surface." },
      { "name": "ink-muted", "value": { "light": "#6b6e76", "dark": "#9a9ca6" }, "usage": "Secondary text, labels, metadata." },
      { "name": "ink-faint", "value": { "light": "#a3a6ad", "dark": "#5c5e66" }, "usage": "Placeholders, disabled text." },
      { "name": "accent", "value": { "light": "#c93e09", "dark": "#ff7a45" }, "usage": "Primary action of a screen (générer, exporter, publier) — at most once per view." },
      { "name": "accent-soft", "value": { "light": "#fbe4d8", "dark": "#3a2013" }, "usage": "Tint behind accent badges and selected states." },
      { "name": "on-accent", "value": { "light": "#ffffff", "dark": "#231005" }, "usage": "Text and icons on a filled accent surface." },
      { "name": "success", "value": { "light": "#1c7a43", "dark": "#4ade80" }, "usage": "Completed render, successful export." },
      { "name": "success-soft", "value": { "light": "#dff3e6", "dark": "#123420" }, "usage": "Tint behind success badges." },
      { "name": "on-success", "value": { "light": "#ffffff", "dark": "#062910" }, "usage": "Text on a filled success surface." },
      { "name": "warning", "value": { "light": "#93590a", "dark": "#fbbf24" }, "usage": "Slow job, quota near its limit, review needed." },
      { "name": "warning-soft", "value": { "light": "#faedd2", "dark": "#3a2b06" }, "usage": "Tint behind warning badges." },
      { "name": "on-warning", "value": { "light": "#ffffff", "dark": "#241a02" }, "usage": "Text on a filled warning surface." },
      { "name": "danger", "value": { "light": "#c1272d", "dark": "#ff6b6b" }, "usage": "Failed job, destructive action." },
      { "name": "danger-soft", "value": { "light": "#fbe1e2", "dark": "#3a1414" }, "usage": "Tint behind danger badges and error banners." },
      { "name": "on-danger", "value": { "light": "#ffffff", "dark": "#2b0a0a" }, "usage": "Text on a filled danger surface." }
    ]
  },
  "type": {
    "families": {
      "sans": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    },
    "groups": [
      {
        "name": "Display",
        "family": "sans",
        "styles": [
          { "name": "display-lg", "fontSize": "40px", "lineHeight": "44px", "fontWeight": 600, "usage": "Page titles, empty states." },
          { "name": "display-sm", "fontSize": "28px", "lineHeight": "34px", "fontWeight": 600, "usage": "Section headers, modal titles." }
        ]
      },
      {
        "name": "Text",
        "family": "sans",
        "styles": [
          { "name": "body-lg", "fontSize": "17px", "lineHeight": "26px", "fontWeight": 400, "usage": "Lead paragraphs, onboarding copy." },
          { "name": "body", "fontSize": "15px", "lineHeight": "22px", "fontWeight": 400, "usage": "Default body copy, form helper text." },
          { "name": "body-sm", "fontSize": "13px", "lineHeight": "18px", "fontWeight": 400, "usage": "Secondary text, metadata, timestamps." }
        ]
      },
      {
        "name": "Label",
        "family": "sans",
        "styles": [
          { "name": "label", "fontSize": "13px", "lineHeight": "16px", "fontWeight": 600, "letterSpacing": "0.01em", "usage": "Buttons, form labels, tabs." },
          { "name": "label-caps", "fontSize": "11px", "lineHeight": "14px", "fontWeight": 700, "letterSpacing": "0.06em", "usage": "Eyebrow tags, overlines — apply text-transform: uppercase." }
        ]
      },
      {
        "name": "Mono",
        "family": "mono",
        "styles": [
          { "name": "mono", "fontSize": "13px", "lineHeight": "20px", "fontWeight": 400, "usage": "Timecodes, durations, file names, technical values." }
        ]
      }
    ]
  },
  "spacing": {
    "tokens": [
      { "name": "space-1", "value": "4px", "usage": "Icon-to-label gaps, tight padding." },
      { "name": "space-2", "value": "8px", "usage": "Badge padding, compact gaps." },
      { "name": "space-3", "value": "12px", "usage": "Input padding, small stacks." },
      { "name": "space-4", "value": "16px", "usage": "Button padding, default gaps." },
      { "name": "space-5", "value": "24px", "usage": "Card padding, section gaps." },
      { "name": "space-6", "value": "32px", "usage": "Between cards, page gutters." },
      { "name": "space-7", "value": "48px", "usage": "Section breaks." },
      { "name": "space-8", "value": "64px", "usage": "Page-level top and bottom spacing." }
    ]
  },
  "radius": {
    "tokens": [
      { "name": "radius-sm", "value": "6px", "usage": "Badges, chips, small controls." },
      { "name": "radius-md", "value": "10px", "usage": "Buttons, inputs, cards." },
      { "name": "radius-lg", "value": "16px", "usage": "Modals, large panels, video thumbnails." },
      { "name": "radius-full", "value": "999px", "usage": "Avatars, status dots, progress-bar ends." }
    ]
  },
  "shadow": {
    "tokens": [
      { "name": "shadow-sm", "value": "0 1px 2px rgba(15,15,20,0.06), 0 1px 1px rgba(15,15,20,0.04)", "usage": "Resting cards, list rows." },
      { "name": "shadow-md", "value": "0 8px 24px rgba(15,15,20,0.14)", "usage": "Popovers, dropdown menus, modals." },
      { "name": "focus-ring", "value": "0 0 0 3px rgba(201,62,9,0.35)", "usage": "Keyboard focus ring, offset from the accent." }
    ]
  }
}
